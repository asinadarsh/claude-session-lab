# Optional overrides. Copy to your shell profile; the app does not load .env files.
SESSION_LAB_PORT=3210
CLAUDE_BINARY=claude
NODE_BINARY=node

# Gateway mode: serve your own linked Claude account over /v1/*.
# Off by default. The master key encrypts stored OAuth tokens; losing it makes
# them unrecoverable, which is intended. Generate with: openssl rand -base64 32
SESSION_LAB_GATEWAY=0
SESSION_LAB_MASTER_KEY=
SESSION_LAB_KEYSTORE=data/keystore.json

# Keep the bind address on loopback and expose only /v1/* through a reverse proxy.
# Binding elsewhere additionally requires SESSION_LAB_ALLOW_PUBLIC_BIND=1.
SESSION_LAB_HOST=127.0.0.1
SESSION_LAB_CORS_ORIGINS=

# Limits
SESSION_LAB_RATE_LIMIT_PER_MINUTE=60
SESSION_LAB_QUEUE_LIMIT=4
SESSION_LAB_MAX_CONNECTIONS=16
SESSION_LAB_MAX_BODY_KB=8192
SESSION_LAB_MAX_PROMPT_CHARS=400000
SESSION_LAB_MAX_MESSAGES=200
SESSION_LAB_MAX_IMAGES=6
SESSION_LAB_MAX_IMAGE_KB=3600
SESSION_LAB_REQUEST_TIMEOUT_S=600
SESSION_LAB_DEFAULT_MAX_TOKENS=4096
